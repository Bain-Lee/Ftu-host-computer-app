<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>TerminalWorkbench</AssemblyName>
    <RootNamespace>TerminalWorkbench</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Defaults\PrjSet_Main.ini.template" LogicalName="TerminalWorkbench.Defaults.PrjSet_Main.ini" />
    <EmbeddedResource Include="..\..\DtuTestManager\bin\Debug\DefaultDevModule\*.mdb" LogicalName="TerminalWorkbench.Defaults.DefaultDevModule/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\DtuTestManager\bin\Debug\DevModuleDataBase\*.mdb" LogicalName="TerminalWorkbench.Defaults.DevModuleDataBase/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\DtuTestManager\bin\Debug\DataBase.mdb" LogicalName="TerminalWorkbench.Defaults.DataBase.mdb" />
    <EmbeddedResource Include="..\..\DtuTestManager\bin\Debug\res\Log.png" LogicalName="TerminalWorkbench.Defaults.res/Log.png" />
  </ItemGroup>
</Project>
